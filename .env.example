# Copy to .env.local and fill in. Never commit .env.local.
SITE_URL=http://localhost:3000

# Admin dashboard (/admin)
ADMIN_PASSWORD=change-this-long-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Contact form email delivery (optional; messages are always saved to the dashboard)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=you@example.com

# AI chatbot (optional; without a key it answers from your profile data)
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5

# Where the JSON database lives (use a persistent volume in production)
DATA_DIR=./data
